# Copy to .env and fill in only what you use. Never commit .env.
# Select the LLM backend: fallback (OpenRouter > Gemini > local) | local | openrouter | gemini   (or disable with SECREVIEW_LLM_ENABLED=false)
SECREVIEW_LLM_PROVIDER=fallback
SECREVIEW_LLM_ENABLED=true

# local (Ollama)
OLLAMA_HOST=http://localhost:11434
SECREVIEW_LOCAL_MODEL=qwen2.5-coder:7b

# OpenRouter
OPENROUTER_API_KEY=
SECREVIEW_OPENROUTER_MODEL=qwen/qwen-2.5-coder-32b-instruct

# Google Gemini
GEMINI_API_KEY=
SECREVIEW_GEMINI_MODEL=gemini-2.5-flash
